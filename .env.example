# LLM 客户端配置（第一阶段解析用）
# 复制为 .env 后填写；.env 已在 .gitignore 中，不要把密钥提交到版本库。

OPENAI_API_KEY=

# OpenAI 兼容网关地址（末尾不要带 /）
QP_LLM_BASE_URL=https://api.aifang.online

# 模型名
QP_LLM_MODEL=deepseek-v4-flash

# 协议：responses | chat_completions
QP_LLM_WIRE_API=responses

# 推理强度：high | medium | low；留空则不发送推理参数
QP_LLM_REASONING_EFFORT=high
